---
import UnifiedCharacterPage from '../../components/UnifiedCharacterPage.astro';
import { ALL_CHARACTERS, loadCharacter } from '../../lib/characters';

export function getStaticPaths(){
  return ALL_CHARACTERS.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const character = loadCharacter(slug!);
---
<UnifiedCharacterPage character={character} />
