---
const { practical } = Astro.props;
const stages = practical?.stages ?? {};
const opportunities = practical?.opportunities ?? [];
const packages = practical?.shared_packages ?? {};
const backend = practical?.backend_only ?? [];
const stageKeys = ['S0','S1','S2','S3','S4'];
const metricPairs = (value = {}) => Object.entries(value).filter(([,v]) => v !== null && v !== undefined && v !== '');
const rowNext = (row) => {
  if (row.next_loop_package && packages[row.next_loop_package]) {
    const p = packages[row.next_loop_package];
    return `${p.sequence} → ${p.next}`;
  }
  return row.next_loop ?? '';
};
---
<section id="practical" class="section pr-section">
  <div class="section-head"><div><h2>PRACTICAL · 一局里怎么用</h2><p>阶段控制复杂度；每一行必须回答“按什么、换到什么、下一步是什么”。</p></div><button id="fullscreen-toggle" class="small-btn" type="button">FULLSCREEN</button></div>
  <div class="pr-toolbar">
    <div class="stage-row">
      {stageKeys.map((s, i) => <button class={`stage-btn ${i===0?'active':''}`} data-stage={s} type="button"><b>{s}</b> · {stages[s]?.label ?? s}</button>)}
      <button class="stage-btn" data-stage="ALL" type="button">ALL</button>
    </div>
    <div class="hub-row">
      <button class="hub-btn active" data-op="ALL" type="button">全部机会</button>
      {opportunities.map((op) => <button class="hub-btn" data-op={op.id} type="button">{op.title.split('｜')[0]}</button>)}
    </div>
  </div>

  <div class="pr-ops">
    {opportunities.map((op) => <article class="pr-op" data-op-block={op.id}>
      <div class="pr-op-head"><h3>{op.title}</h3>{op.subtitle && <p>{op.subtitle}</p>}{op.guide?.short && <p>WHY · {op.guide.short}</p>}</div>
      <div class="table-wrap">
        <table class="pr-table">
          <thead><tr><th>RESULT / CHOICE</th><th>完整输入</th><th>价值 / 资源</th><th>NEXT LOOP · WHY</th></tr></thead>
          <tbody>
            {(op.rows ?? []).map((row) => <tr class="pr-row" data-row-stage={row.stage ?? op.stage ?? 'S0'}>
              <td><span class={`result ${String(row.result ?? '').toLowerCase()}`}>{row.result}</span><span class="choice">{row.choice}</span></td>
              <td><div class="route">{row.input}</div>{row.conditions?.length && <div class="why">条件：{row.conditions.join(' / ')}</div>}</td>
              <td><div class="metrics">{metricPairs(row.value).map(([k,v]) => <span class="metric">{k}: {String(v)}</span>)}</div>{row.verification && <div class="why">{row.verification}</div>}</td>
              <td><div class="next">{rowNext(row)}</div><div class="why">WHY · {row.why}</div></td>
            </tr>)}
          </tbody>
        </table>
      </div>
    </article>)}
  </div>

  {backend.length > 0 && <details class="backend"><summary>Backend only / 仍未进入学习表的内容 ({backend.length})</summary><ul>{backend.map((x) => <li><b>{x.label}</b> — {x.reason}</li>)}</ul></details>}
</section>

<script is:inline>
  (() => {
    const rank = {S0:0,S1:1,S2:2,S3:3,S4:4};
    const stageBtns = [...document.querySelectorAll('[data-stage]')];
    const hubBtns = [...document.querySelectorAll('[data-op]')];
    const rows = [...document.querySelectorAll('[data-row-stage]')];
    const ops = [...document.querySelectorAll('[data-op-block]')];
    let stage = 'S0';
    let opportunity = 'ALL';

    function render(){
      const selectedRank = stage === 'ALL' ? 99 : rank[stage];
      rows.forEach(row => {
        const r = rank[row.dataset.rowStage] ?? 0;
        row.style.display = stage === 'ALL' || r <= selectedRank ? '' : 'none';
        row.classList.toggle('stage-current', stage !== 'ALL' && r === selectedRank);
      });
      ops.forEach(op => {
        const matches = opportunity === 'ALL' || op.dataset.opBlock === opportunity;
        const hasVisible = [...op.querySelectorAll('[data-row-stage]')].some(r => r.style.display !== 'none');
        op.style.display = matches && hasVisible ? '' : 'none';
      });
      stageBtns.forEach(b => b.classList.toggle('active', b.dataset.stage === stage));
      hubBtns.forEach(b => b.classList.toggle('active', b.dataset.op === opportunity));
    }
    stageBtns.forEach(b => b.addEventListener('click', () => {stage=b.dataset.stage;render()}));
    hubBtns.forEach(b => b.addEventListener('click', () => {opportunity=b.dataset.op;render()}));
    document.getElementById('fullscreen-toggle')?.addEventListener('click', () => document.body.classList.toggle('fullscreen'));
    render();
  })();
</script>
